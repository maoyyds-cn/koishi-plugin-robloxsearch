# 监听端口
PORT=3682

# 监听地址（一般保持 0.0.0.0）
HOST=0.0.0.0

# 对外可访问的基础地址，用于拼接返回的 localUrl。
# 公网部署必须改成你的域名/公网地址，例如 https://img.example.com
PUBLIC_BASE_URL=http://127.0.0.1:3682

# 可选鉴权 token：设置后请求须携带 Authorization: Bearer <token>。
# 留空 = 不鉴权（兼容现有插件，但公网部署强烈建议设置并通过反代只暴露本服务）。
AUTH_TOKEN=

# 可选域名白名单（逗号分隔），例如 rbxcdn.com,roblox.com
# 留空 = 允许任意公网域名（服务仍会拦截内网/保留 IP，防 SSRF）
ALLOWED_HOSTS=

# 单张图片大小上限（MB）
MAX_SIZE_MB=10

# 图片保留时长（小时），超时自动清理
KEEP_HOURS=24

# 每分钟每 IP 请求上限
RATE_PER_MIN=60